<?xml version="1.0" encoding="utf-8"?>
<!--
  Le jeu est en paysage et n'utilise que sa toile : ni réseau, ni fichiers
  partagés, ni capteurs. Aucune permission n'est donc demandée — c'est ce que
  l'on peut offrir de mieux à quelqu'un qui installe un APK hors magasin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasFragileUserData="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!--
              Android 16 cesse d'honorer `screenOrientation` et
              `resizeableActivity` sur tout écran d'au moins 600 dp. Or la
              toile du jeu est figée en 216x384 à la compilation : sur une
              tablette, la fenêtre deviendrait paysage avec un jeu qui
              n'existe qu'en portrait.

              Cette propriété rétablit l'ancien comportement. Elle est
              temporaire — elle cessera d'agir dès l'API 37 —, et d'ici là il
              faudra décider de ce que Glyphfall fait sur grand écran.
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
