<?xml version="1.0" encoding="utf-8"?>
<!--
  Le jeu est en paysage et n'utilise que sa toile : ni réseau, ni fichiers
  partagés, ni capteurs. Aucune permission n'est donc demandée — c'est ce que
  l'on peut offrir de mieux à quelqu'un qui installe un APK hors magasin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasFragileUserData="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
